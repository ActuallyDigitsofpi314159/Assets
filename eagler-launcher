/* Eaglercraft Standalone Loader 2 - Direct DOM & ES5 Compatible */
(function() {
    // ============================================================================
    // 1. GTM STUB & ANALYTICS CRASH PREVENTER (ES5)
    // ============================================================================
    window.dataLayer = window.dataLayer || [];
    window.gtag = window.gtag || function() {};
    window.google_tag_manager = window.google_tag_manager || {};

    (function() {
        var originalAppendChild = Element.prototype.appendChild;
        var originalInsertBefore = Element.prototype.insertBefore;

        function isAllowed(url) {
            if (!url) return true;
            var allowedDomains = [
                'cdn.jsdelivr.net',
                'cdnjs.cloudflare.com',
                'rawgit.com',
                'cdn.rawgit.com',
                'ajax.googleapis.com',
                'kastatic.org',
                'khanacademy.org'
            ];
            for (var i = 0; i < allowedDomains.length; i++) {
                if (url.indexOf(allowedDomains[i]) !== -1) return true;
            }
            return false;
        }

        Element.prototype.appendChild = function(child) {
            if (child && child.tagName === 'SCRIPT' && child.src && !isAllowed(child.src)) {
                console.warn('[CSP Patch] Prevented blocked script load:', child.src);
                return child;
            }
            return originalAppendChild.apply(this, arguments);
        };

        Element.prototype.insertBefore = function(newNode, referenceNode) {
            if (newNode && newNode.tagName === 'SCRIPT' && newNode.src && !isAllowed(newNode.src)) {
                console.warn('[CSP Patch] Prevented blocked script load:', newNode.src);
                return newNode;
            }
            return originalInsertBefore.apply(this, arguments);
        };
    })();

    // ============================================================================
    // 2. MULTI-THREADING WORKER BLOB PATCH (ES5)
    // ============================================================================
    (function() {
        var NativeWorker = window.Worker;
        window.Worker = function(scriptURL, options) {
            if (typeof scriptURL === 'string' && scriptURL.indexOf('blob:') !== 0) {
                try {
                    var xhr = new XMLHttpRequest();
                    xhr.open('GET', scriptURL, false);
                    xhr.send();
                    var blob = new Blob([xhr.responseText], { type: 'application/javascript' });
                    return new NativeWorker(URL.createObjectURL(blob), options);
                } catch(e) {
                    console.warn('Worker Blob fallback active:', e);
                }
            }
            return new NativeWorker(scriptURL, options);
        };
    })();

    // ============================================================================
    // 3. IMAGE & WEBGL ASSET INTERCEPTORS (ES5)
    // ============================================================================
    (function() {
        var _createImageBitmap = window.createImageBitmap;
        window.Image = function() {
            var img = {
                src: '',
                onload: null,
                onerror: null,
                width: 0,
                height: 0,
                _bitmap: null
            };
            Object.defineProperty(img, 'src', {
                set: function(val) {
                    this._src = val;
                    if (!val) return;
                    fetch(val)
                        .then(function(res) { return res.blob(); })
                        .then(function(blob) { return _createImageBitmap(blob); })
                        .then(function(bitmap) {
                            img._bitmap = bitmap;
                            img.width = bitmap.width;
                            img.height = bitmap.height;
                            if (img.onload) img.onload();
                        })
                        .catch(function(err) {
                            if (img.onerror) img.onerror(err);
                        });
                },
                get: function() { return this._src; }
            });
            return img;
        };

        var CanvasRenderingContext2D = window.CanvasRenderingContext2D;
        if (CanvasRenderingContext2D) {
            var _drawImage = CanvasRenderingContext2D.prototype.drawImage;
            CanvasRenderingContext2D.prototype.drawImage = function(image) {
                var args = Array.prototype.slice.call(arguments);
                if (image && image._bitmap) args[0] = image._bitmap;
                return _drawImage.apply(this, args);
            };
        }

        var WebGLRenderingContext = window.WebGLRenderingContext;
        if (WebGLRenderingContext) {
            var _texImage2D = WebGLRenderingContext.prototype.texImage2D;
            WebGLRenderingContext.prototype.texImage2D = function() {
                var args = Array.prototype.slice.call(arguments);
                for (var i = 0; i < args.length; i++) {
                    if (args[i] && args[i]._bitmap) args[i] = args[i]._bitmap;
                }
                return _texImage2D.apply(this, args);
            };
        }
    })();

    // ============================================================================
    // 4. UI SETUP & DOM INJECTION (ES5)
    // ============================================================================
    function setupDOM() {
        // Inject page styles
        var style = document.createElement('style');
        style.innerHTML = 
            'html, body { width: 100%; height: 100%; margin: 0; padding: 0; overflow: hidden; background: #000; font-family: sans-serif; } ' +
            '#canvas { width: 100vw; height: 100vh; display: block; border: none; outline: none; } ' +
            '#status_overlay { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); color: #fff; font-size: 18px; font-weight: bold; text-align: center; pointer-events: none; z-index: 9999; }';
        document.head.appendChild(style);

        // Create overlay element if missing
        var statusEl = document.getElementById('status_overlay');
        if (!statusEl) {
            statusEl = document.createElement('div');
            statusEl.id = 'status_overlay';
            statusEl.innerText = 'Initializing Standalone Engine...';
            document.body.appendChild(statusEl);
        }

        // Create canvas element if missing
        var canvasEl = document.getElementById('canvas');
        if (!canvasEl) {
            canvasEl = document.createElement('canvas');
            canvasEl.id = 'canvas';
            canvasEl.tabIndex = 1;
            document.body.appendChild(canvasEl);
        }

        // Focus & Key Lock
        function grabFocus() {
            window.focus();
            if (canvasEl) canvasEl.focus();
        }

        window.addEventListener('pointerdown', grabFocus);
        window.addEventListener('keydown', function(e) {
            if (['Space', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].indexOf(e.code) !== -1) {
                if (document.activeElement === canvasEl) {
                    e.preventDefault();
                }
            }
        });

        return { statusEl: statusEl, canvasEl: canvasEl, grabFocus: grabFocus };
    }

    // ============================================================================
    // 5. ASYNC DECODER & ENGINE LAUNCHER (ES5)
    // ============================================================================
    window.base64ToUint8ArrayAsync = function(base64, progressCb, doneCb) {
        var raw = atob(base64);
        var rawLength = raw.length;
        var array = new Uint8Array(rawLength);
        var chunkSize = 131072;
        var index = 0;

        function processChunk() {
            var end = Math.min(index + chunkSize, rawLength);
            for (var i = index; i < end; i++) {
                array[i] = raw.charCodeAt(i);
            }
            index = end;
            if (progressCb) progressCb(Math.floor((index / rawLength) * 100));
            if (index < rawLength) {
                setTimeout(processChunk, 4);
            } else {
                doneCb(array);
            }
        }
        processChunk();
    };

    window.launchEngineDirect = function(engineCodeText) {
        var dom = setupDOM();
        dom.statusEl.innerText = 'Starting Game Engine...';

        // Set global engine options with WebRTC enabled
        window.eaglercraftXOpts = {
            container: 'canvas',
            assetsURI: 'assets.epk',
            localesURI: 'lang/',
            joinServer: null,
            servers: [
                { addr: 'wss://relays.eaglercraft.com/loopback', name: 'WebRTC LAN Relay' }
            ],
            allowCORS: true,
            enableWebRTC: true
        };

        // Inject engine code into document head
        var script = document.createElement('script');
        script.type = 'text/javascript';
        script.text = engineCodeText;
        document.head.appendChild(script);

        setTimeout(function() {
            dom.statusEl.style.display = 'none';
            dom.grabFocus();
        }, 500);
    };

    // Auto-fetch engine payload from jsDelivr on page load
    window.addEventListener('DOMContentLoaded', function() {
        var dom = setupDOM();
        dom.statusEl.innerText = 'Fetching Game Payload...';

        fetch('https://cdn.jsdelivr.net/gh/actuallydigitsofpi314159/assets@main/eagler-assets-2.js')
            .then(function(res) {
                return res.text();
            })
            .then(function(code) {
                window.launchEngineDirect(code);
            })
            .catch(function(err) {
                dom.statusEl.innerText = 'Failed to load engine payload.';
                console.error(err);
            });
    });
})();
