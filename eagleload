(function() {
    let logs = [];
    function log(msg) {
        logs.push(msg);
        console.log(msg);
        let el = document.getElementById('status-log');
        if (el) el.innerText = logs.slice(-6).join('\n');
    }

    // 1. Mock window.Image & document.createElement('img') to bypass CSP restrictions
    window.Image = function(width, height) {
        let listeners = { load: [], error: [] };
        let self = {
            width: width || 0, height: height || 0, naturalWidth: 0, naturalHeight: 0, complete: false,
            _bitmap: null, _src: "",
            get src() { return this._src; },
            set src(url) {
                this._src = url;
                let that = this;
                fetch(url).then(res => res.blob()).then(blob => createImageBitmap(blob)).then(bitmap => {
                    that._bitmap = bitmap;
                    that.width = bitmap.width; that.height = bitmap.height;
                    that.naturalWidth = bitmap.width; that.naturalHeight = bitmap.height;
                    that.complete = true;
                    if (that.onload) that.onload();
                    listeners.load.forEach(cb => cb());
                }).catch(err => {
                    if (that.onerror) that.onerror(err);
                    listeners.error.forEach(cb => cb(err));
                });
            },
            onload: null, onerror: null,
            addEventListener: function(type, cb) { if (listeners[type]) listeners[type].push(cb); },
            removeEventListener: function(type, cb) {
                if (listeners[type]) {
                    let idx = listeners[type].indexOf(cb);
                    if (idx !== -1) listeners[type].splice(idx, 1);
                }
            },
            __isMockImage: true
        };
        return self;
    };
    let _origCreateElement = document.createElement;
    document.createElement = function(tagName, options) {
        if (tagName && typeof tagName === 'string' && tagName.toLowerCase() === 'img') {
            return new window.Image();
        }
        return _origCreateElement.call(this, tagName, options);
    };

    // 2. Patch Canvas drawImage & WebGL textures for mock images
    let _nativeDrawImage = CanvasRenderingContext2D.prototype.drawImage;
    CanvasRenderingContext2D.prototype.drawImage = function(img) {
        if (img && img.__isMockImage && img._bitmap) {
            let args = Array.prototype.slice.call(arguments);
            args[0] = img._bitmap;
            return _nativeDrawImage.apply(this, args);
        }
        return _nativeDrawImage.apply(this, arguments);
    };
    function _patchTex(proto) {
        if (!proto) return;
        let _origTex = proto.texImage2D;
        if (_origTex) {
            proto.texImage2D = function() {
                let args = Array.prototype.slice.call(arguments);
                let last = args[args.length - 1];
                if (last && last.__isMockImage && last._bitmap) args[args.length - 1] = last._bitmap;
                return _origTex.apply(this, args);
            };
        }
    }
    _patchTex(window.WebGLRenderingContext && WebGLRenderingContext.prototype);
    _patchTex(window.WebGL2RenderingContext && WebGL2RenderingContext.prototype);

    // 3. Mouse Pointer Lock & Canvas Focus
    let canvas = document.getElementById('game-canvas');
    canvas.addEventListener('click', function() {
        canvas.focus();
        if (document.pointerLockElement !== canvas) {
            canvas.requestPointerLock();
        }
    });

    // 4. Auto-dismiss single-threaded integrated server warning dialog
    setInterval(function() {
        let buttons = document.querySelectorAll('button, div');
        for (let i = 0; i < buttons.length; i++) {
            let text = buttons[i].innerText || '';
            if (text.indexOf('Cancel') !== -1 || text.indexOf('Single-Threaded') !== -1 || text.indexOf('Proceed') !== -1) {
                if (buttons[i].offsetParent !== null) {
                    buttons[i].click();
                }
            }
        }
    }, 200);

    window.minecraftOpts = ['game_frame', ''];
    window.eaglercraftXOpts = {
        container: 'game_frame',
        canvas: canvas,
        assetsURI: '',
        localesURI: '',
        joinServer: ''
    };

    // 5. Data URI fetch mocks
    let _nativeFetch = window.fetch;
    window.fetch = function(input, init) {
        let url = typeof input === 'string' ? input : (input && input.url ? input.url : String(input));
        if (url && url.indexOf('data:') === 0) {
            return new Promise(function(resolve) {
                try {
                    let commaIdx = url.indexOf(',');
                    let isBase64 = url.indexOf('base64') !== -1;
                    let dataPart = url.substring(commaIdx + 1);
                    let raw = isBase64 ? atob(dataPart) : decodeURIComponent(dataPart);
                    let arr = new Uint8Array(raw.length);
                    let i = 0; while (i < raw.length) { arr[i] = raw.charCodeAt(i); i++; }
                    let mimeMatch = url.match(new RegExp('data:(.*?);'));
                    let mime = mimeMatch ? mimeMatch[1] : 'application/octet-stream';
                    resolve(new Response(arr.buffer, { status: 200, statusText: 'OK', headers: {'Content-Type': mime} }));
                } catch (e) { resolve(new Response(new ArrayBuffer(0), { status: 500 })); }
            });
        }
        return _nativeFetch.apply(this, arguments);
    };

    // 6. Base64 Chunk Decoder & Engine Unpacker
    function base64ToUint8ArrayAsync(base64, chunkSize, onProgress) {
        return new Promise(function(resolve, reject) {
            try {
                let binaryString = window.atob(base64);
                let len = binaryString.length;
                let bytes = new Uint8Array(len);
                let offset = 0;
                let step = chunkSize || 131072;
                function processChunk() {
                    let end = Math.min(offset + step, len);
                    let i = offset;
                    while (i < end) { bytes[i] = binaryString.charCodeAt(i); i++; }
                    offset = end;
                    if (onProgress) onProgress(Math.floor((offset / len) * 100));
                    if (offset < len) { setTimeout(processChunk, 4); } else { resolve(bytes); }
                }
                processChunk();
            } catch (err) { reject(err); }
        });
    }

    log('Loading asset pack...');
    let assetScript = document.createElement('script');
    assetScript.src = 'https://cdn.jsdelivr.net/gh/ActuallyDigitsofpi314159/Assets@main/eagler_assets.js';
    assetScript.onload = function() {
        log('Assets loaded, unpacking engine payload...');
        let rawBase64 = window.EAGLER_GZ_BASE64;
        if (!rawBase64) {
            log('ERROR: No EAGLER_GZ_BASE64 found');
            return;
        }
        base64ToUint8ArrayAsync(rawBase64, 131072, function(p) {
            log('Decoding payload: ' + p + '%');
        }).then(function(gzipData) {
            let ds = new DecompressionStream('gzip');
            let writer = ds.writable.getWriter();
            writer.write(gzipData);
            writer.close();
            return new Response(ds.readable).arrayBuffer();
        }).then(function(decompressedBuffer) {
            log('Decompressed code, executing...');
            let codeText = new TextDecoder('utf-8').decode(decompressedBuffer);
            let engineScript = document.createElement('script');
            engineScript.text = codeText;
            document.body.appendChild(engineScript);
            log('Engine running!');
            setTimeout(() => { let el = document.getElementById('status-log'); if (el) el.style.display = 'none'; }, 2000);
        }).catch(function(err) {
            log('ERROR: ' + (err.message || err));
        });
    };
    document.body.appendChild(assetScript);
})();
